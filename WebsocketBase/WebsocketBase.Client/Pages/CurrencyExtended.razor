@page "/currencyextended"
@using WebsocketBase.Client.Services
@using WebsocketBase.Shared.Messages

@inject WebSocketService WebSocketService

<h3>WebSocket - Kursy Walut</h3>

<button @onclick="Connect" disabled="@isConnected">Connect</button>
<button @onclick="Disconnect" disabled="@(!isConnected)">Disconnect</button>

@if (!isConnected)
{
    <p>Brak połączenia lub dane są niedostępne.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Waluta</th>
                <th>Kupno</th>
                <th>Sprzedaż</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rate in currencyRates)
            {
                <tr>
                    <td>@rate.Name</td>
                    <td>@rate.BuyPrice</td>
                    <td>@rate.SellPrice</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CurrencyRate> currencyRates = new();
    private bool isConnected;

    protected override void OnInitialized()
    {
        WebSocketService.OnRatesUpdated += rates =>
        {
            currencyRates = rates;
            InvokeAsync(StateHasChanged);
        };

        WebSocketService.OnDisconnected += () =>
        {
            isConnected = false;
            currencyRates.Clear();
            InvokeAsync(StateHasChanged);
        };
    }

    private async Task Connect()
    {
        try
        {
            await WebSocketService.ConnectAsync();
            isConnected = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd połączenia: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task Disconnect()
    {
        try
        {
            await WebSocketService.DisconnectAsync();
            isConnected = false;
            currencyRates.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd rozłączania: {ex.Message}");
        }
        StateHasChanged();
    }
}


