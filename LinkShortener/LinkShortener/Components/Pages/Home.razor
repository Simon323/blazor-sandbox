@page "/"

<PageTitle>Home</PageTitle>

<SectionContent SectionName="heading">
	<h1 class="text-main fw-bold text-center">URL Shortner - <small>Shorten any long Link/Url</small></h1>
</SectionContent>

<div class="row">
	<div class="col-sm-6 my-5 mx-auto shadow rounded">
		<ShortGeneratorForm @rendermode="InteractiveAuto" />
	</div>
</div>

<div class="row my-5">
	<div class="col-12">
		<h3 class="text-main fw-bold mb-4">Features</h3>
		<ul class="list-unstyled">
			<li>
				<p class="h3 mb-3">
					<span class="">&rarr;</span>Shorten any long url
				</p>
			</li>
			<li>
				<p class="h3 mb-3">
					<span class="">&rarr;</span>Copy the shorten url to clipboard
				</p>
			</li>
			<li>
				<p class="h3 mb-3">
					<span class="">&rarr;</span>Share the shorten URL
				</p>
			</li>
			<li>
				<p class="h3 mb-3">
					<span class="">&rarr;</span>Track the number of click the shorten url
				</p>
			</li>
			<li>
				<p class="h3 mb-3">
					<span class="">&rarr;</span>And it free to use
				</p>
			</li>
		</ul>
	</div>
</div>
